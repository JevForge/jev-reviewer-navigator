{
  "name": "jev-reviewer-navigator",
  "version": "0.4.4",
  "description": "Suggest PR reviewers from CODEOWNERS, history, paths, labels, and teams. Jev decides; assignment stays explicit.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "github-actions",
    "jev",
    "typesafe",
    "code-review",
    "reviewers",
    "jevforge"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "ai": "^7.0.113",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
